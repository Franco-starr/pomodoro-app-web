{
  "name": "pomodoro-3d",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron . --dev",
    "electron:build": "vite build && electron-builder --win --x64",
    "electron:preview": "electron ."
  },
  "build": {
    "appId": "com.pomodoro.pomodoro3d",
    "productName": "Pomodoro App",
    "directories": {
      "output": "release",
      "buildResources": "electron/assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/videos/**/*",
      "public/workers/**/*",
      "public/model/**/*",
      "public/hdri/**/*",
      "public/audio/**/*",
      "public/img/**/*"
    ],
    "extraResources": [
      {
        "from": "public/videos",
        "to": "videos",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico",
      "artifactName": "${productName}-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "vite": "^8.0.4"
  },
  "dependencies": {
    "three": "^0.183.2"
  }
}